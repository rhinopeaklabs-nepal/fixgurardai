# Empty means same origin, which is how the deployed stack serves it:
# nginx hands /api to the api container. Set a full origin only when the
# API lives somewhere else, as it does in local development.
VITE_API_BASE_URL=http://127.0.0.1:8000

# There is no API key here. The dashboard signs in with an account and
# carries an httpOnly session cookie; the API key is now only ever used
# server to server, and by the test suite.
