FIXGUARD_API_KEY=change-me-before-deploy
CORS_ORIGINS=https://your-dashboard-domain.com
PUBLIC_BASE_URL=https://your-dashboard-domain.com
MAX_CONCURRENT_AUDITS=1
AUDIT_HARD_TIMEOUT_S=90
# Audit starts allowed per API key per hour (SRS 5.4). Audits that cannot
# reach the target are refunded and do not count.
RATE_LIMIT_PER_HOUR=10
